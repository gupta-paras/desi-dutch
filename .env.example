# ==============================================================================
# DESI DUTCH - ENVIRONMENT CONFIGURATION (EXAMPLE)
# ==============================================================================

# Admin Credentials
ADMIN_USERNAME="admin"
# SHA-256 hash of password (e.g. SHA-256 for 'bestFoodInNl@123'):
ADMIN_PASSWORD_HASH="5b0885b3479975349c10e21359d69a34187a281e38d1b35300257db059093f5d"

# Session Security Secret
SESSION_SECRET="desi-dutch-secret-key-amsterdam-delhi-2026"

# Turso Cloud SQLite Database (Required for Vercel Free Tier production persistence)
# Create a free database at https://turso.tech:
#   turso db create desi-dutch
#   turso db show --url desi-dutch
#   turso db tokens create desi-dutch
TURSO_DATABASE_URL="libsql://desi-dutch-[your-org].turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token-here"

# Database Fallback Control
# Set to "true" only for local offline development or tests when Turso is unavailable.
# Defaults to "false". When false, missing Turso credentials will throw a descriptive error.
ENABLE_LOCAL_SQLITE_FALLBACK="false"
