# ==============================================================================
# DESI DUTCH - ENVIRONMENT VARIABLES
# ==============================================================================

# NextAuth Configuration
# Run `openssl rand -base64 32` or use any secure random string
NEXTAUTH_SECRET="desi-dutch-secret-key-jaipur-amsterdam-2024"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth Credentials (for Whitelisted Google Sign In to /admin)
# Obtain these from Google Cloud Console -> APIs & Services -> Credentials
# Authorized redirect URI: https://<your-vercel-domain>.vercel.app/api/auth/callback/google
# (and http://localhost:3000/api/auth/callback/google for local dev)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional override for whitelisted admin emails (comma-separated).
# If omitted, emails in config.yaml under `admin_users` are strictly used.
# ADMIN_WHITELIST="admin@desidutch.nl,paras@desidutch.nl,your-email@gmail.com"

# Optional Developer Passcode for local testing before Google OAuth credentials are added
ADMIN_DEV_PASSWORD="admin"

# Optional Vercel Blob Token (if uploading photos to Vercel Blob instead of base64/local)
# BLOB_READ_WRITE_TOKEN=""
